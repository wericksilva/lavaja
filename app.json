{
  "expo": {
    "name": "LavaJá",
    "slug": "lavaja",
    "scheme": "lavaja",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/lavaja"
    }
  }
}
