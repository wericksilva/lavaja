{
  "expo": {
    "name": "LavaJá",
    "slug": "lavaja",
    "scheme": "lavaja",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/lavaja"
    },
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon-48.png",
      "name": "LavaJá",
      "shortName": "LavaJá",
      "themeColor": "#0878E8",
      "backgroundColor": "#F4F8FC",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
